{
  "name": "context-manager",
  "private": true,
  "pnpm": {
    "overrides": {
      "@develar/schema-utils>ajv": "6.12.6",
      "dmg-license>ajv": "6.12.6"
    }
  },
  "scripts": {
    "build": "turbo build",
